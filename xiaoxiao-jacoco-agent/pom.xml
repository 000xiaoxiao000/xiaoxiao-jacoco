<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xiaoxiao</groupId>
        <artifactId>xiaoxiao-jacoco</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>xiaoxiao-jacoco-agent</artifactId>
    <packaging>jar</packaging>

    <name>xiaoxiao-jacoco-agent</name>
    <description>
        xiaoxiao-jacoco agent：挂在目标 JVM 上做覆盖率采集。
        支持 JaCoCo agent 的【全部】参数（destfile / append / includes / excludes / exclclassloader /
        inclbootstrapclasses / inclnolocationclasses / sessionid / dumponexit / output /
        address / port / classdumpdir / jmx），并扩展了按 key（用户 / 用例 / 请求头）分离的能力。

        打包：mvn -pl xiaoxiao-jacoco-agent -o package  ->  target/xiaoxiao-jacoco-agent.jar（fat jar）
        使用：java -javaagent:/abs/xiaoxiao-jacoco-agent.jar=outdir=coverage,autokey=default -jar app.jar
    </description>

    <dependencies>
        <!-- ASM：字节码插桩与 HttpServlet 钩子织入 -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
        </dependency>
        <!-- JaCoCo core：探针插桩 + ExecutionData / exec 写出 + 远程协议 + AgentOptions 解析 -->
        <dependency>
            <groupId>org.jacoco</groupId>
            <artifactId>org.jacoco.core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- ${jar.suffix}：默认空（剥离调试信息的交付版）；-Pdebug-symbols 时为 -debug（内部排障版） -->
        <finalName>xiaoxiao-jacoco-agent${jar.suffix}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- 打成 fat agent jar：把 asm + jacoco.core 全部并进去（不含 report/CLI） -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>**/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <!-- 关键：把 ASM 重定位到私有包，避免污染目标应用。
                                 -javaagent 的 jar 会被挂到目标应用的 system classpath 上，
                                 若裸打包 org.objectweb.asm，就会与应用自带的 ASM（任意版本）撞车。
                                 重定位后探针自带一份私有 ASM，与应用完全隔离
                                 —— 是【探针适应目标系统】，而不是让目标系统来适配探针。
                                 注意：改名后必须同步 PerUserTransformer.isAgentInternal /
                                 Options.joinExcludes 里的包名白名单，否则 agent 会去插桩自己的 ASM。 -->
                            <relocations>
                                <relocation>
                                    <pattern>org.objectweb.asm</pattern>
                                    <shadedPattern>com.xiaoxiao.jacoco.shaded.asm</shadedPattern>
                                </relocation>
                                <!-- JaCoCo core 同样必须私有化。
                                     目标系统里很可能已经有 org.jacoco.*（另一个版本的 jacoco 依赖、
                                     或另一个覆盖率/诊断 agent），裸打包就会撞车 —— 那是让【目标系统给探针让路】。
                                     重定位后探针自带一份私有 JaCoCo，与业务完全隔离。
                                     注意：relocation 是【前缀匹配】，所以 peruser / peruserrt 不能拿来当 pattern
                                     （peruserrt 会被 peruser 前缀误伤），它们保持原样：peruserrt 是业务可见 API，
                                     peruser 是探针私有实现、名字空间独立。 -->
                                <relocation>
                                    <pattern>org.jacoco</pattern>
                                    <shadedPattern>com.xiaoxiao.jacoco.shaded.jacoco</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Premain-Class>peruser.PerUserAgent</Premain-Class>
                                        <Agent-Class>peruser.PerUserAgent</Agent-Class>
                                        <Can-Redefine-Classes>true</Can-Redefine-Classes>
                                        <Can-Retransform-Classes>true</Can-Retransform-Classes>
                                        <!-- 这里【刻意不写】Implementation-Title / Implementation-Version：
                                             它们会暴露实现名与版本，对反编译方是白送的指纹；
                                             MANIFEST 里只保留 JVM 真正要读的四个入口属性。 -->
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
