<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.xiaoxiao</groupId>
    <artifactId>xiaoxiao-jacoco</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>xiaoxiao-jacoco</name>
    <description>
        xiaoxiao-jacoco：按用户 / 按用例分离覆盖率的 JaCoCo 增强套件。
        拆分为两个【可独立打包】的模块：
          - xiaoxiao-jacoco-agent：Java Agent（挂在目标 JVM 上采集），支持 JaCoCo agent 的全部参数；
          - xiaoxiao-jacoco-cli   ：离线命令行工具（report / merge / dump / instrument / classinfo / execinfo / version），
                                    支持 JaCoCo cli 的全部命令与参数。
        两个模块互不依赖：目标系统只需 agent jar，出报告的机器只需 cli jar。
    </description>

    <modules>
        <module>xiaoxiao-jacoco-agent</module>
        <module>xiaoxiao-jacoco-cli</module>
    </modules>

    <properties>
        <!-- 目标字节码 = Java 8，保证在 Java 8+ 的目标 JVM 上可加载 -->
        <maven.compiler.release>8</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <asm.version>9.10.1</asm.version>
        <!-- 注意：jacoco 是本地定制构建（版本号带日期后缀），不是 Maven Central 的标准 0.8.15。
             为保证覆盖率格式/字节码与之前完全一致，必须用本地 .m2 里的定制版（见 setup-m2.sh）。 -->
        <jacoco.version>0.8.15.202606040825</jacoco.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-tree</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jacoco</groupId>
                <artifactId>org.jacoco.core</artifactId>
                <version>${jacoco.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jacoco</groupId>
                <artifactId>org.jacoco.report</artifactId>
                <version>${jacoco.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <release>8</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
